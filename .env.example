# Everything here is optional. Leave the Supabase variables unset to run the built-in demo
# (synthetic data in the browser, one-click demo logins).
# To use a real Supabase project, copy this file to .env.local and fill it in. Never commit the real file.
# All VITE_* values are compiled into the browser bundle, so only put public values here.

# Supabase project URL (Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon / publishable key (public by design; access is enforced by row level security).
# VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY is accepted as a fallback name.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional. Base URL used for public review links, QR codes and Open Graph tags,
# e.g. https://reviews.example.com. Leave empty to use the current browser origin.
VITE_PUBLIC_APP_URL=
