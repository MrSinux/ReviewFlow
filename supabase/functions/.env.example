# Secrets for the send-feedback-reply Edge Function.
# Local: copy to supabase/functions/.env and run `supabase functions serve --env-file supabase/functions/.env`
# Hosted: `supabase secrets set RESEND_API_KEY=... RESEND_FROM_EMAIL=...`
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by Supabase automatically; do not set them here.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_your_resend_api_key

# Verified sender, e.g. "Your Business <replies@example.com>"
RESEND_FROM_EMAIL=Your Business <replies@example.com>
